{
  "_doc": "Conformance cases for core/vessel_rules.json. BOTH interpreters — core/validate.py (the parse gate + the live API) and web/frontend/scripts/lib/vesselRules.mjs (schema-audit) — must produce exactly `expect` ([step index, rule id], in step order) for every case. This is what keeps two readers of one data file from drifting.",
  "cases": [
    { "name": "a parse that keeps every vessel rule",
      "steps": [ {"index": 1, "action": "pour_add", "container": "microtube"}, {"index": 2, "action": "transfer", "container": "spin_column"},
                 {"index": 3, "action": "pour_add"}, {"index": 4, "action": "elute", "container": "eluate_tube"} ],
      "expect": [] },
    { "name": "an elute that names no vessel",
      "steps": [ {"index": 1, "action": "pour_add", "container": "microtube"}, {"index": 2, "action": "elute"} ],
      "expect": [[2, "elute-collects-into-eluate-tube"]] },
    { "name": "an elute into a plain tube",
      "steps": [ {"index": 1, "action": "pour_add", "container": "microtube"}, {"index": 2, "action": "elute", "container": "tube"} ],
      "expect": [[2, "elute-collects-into-eluate-tube"]] },
    { "name": "run 2: water added 'into' the eluate tube before the elution",
      "steps": [ {"index": 1, "action": "pour_add", "container": "microtube"}, {"index": 2, "action": "pour_add", "container": "eluate_tube"},
                 {"index": 3, "action": "elute", "container": "eluate_tube"} ],
      "expect": [[2, "eluate-tube-entered-only-by-elute"]] },
    { "name": "staying in the eluate tube after the elution is fine",
      "steps": [ {"index": 1, "action": "pour_add", "container": "microtube"}, {"index": 2, "action": "elute", "container": "eluate_tube"},
                 {"index": 3, "action": "measure", "container": "eluate_tube"} ],
      "expect": [] },
    { "name": "the first sample step names no vessel (a side prepare does not count)",
      "steps": [ {"index": 1, "action": "prepare", "container": "tube"}, {"index": 2, "action": "pipette_mix"} ],
      "expect": [[2, "first-step-names-container"]] },
    { "name": "a seed that names no vessel",
      "steps": [ {"index": 1, "action": "pour_add", "container": "tube"}, {"index": 2, "action": "seed"} ],
      "expect": [[2, "move-names-destination"]] },
    { "name": "an unknown container token is not a named vessel",
      "steps": [ {"index": 1, "action": "pour_add", "container": "beaker"} ],
      "expect": [[1, "first-step-names-container"]] },
    { "name": "a prepare into an eluate tube is on the side, not the sample entering it",
      "steps": [ {"index": 1, "action": "pour_add", "container": "microtube"}, {"index": 2, "action": "prepare", "container": "eluate_tube"} ],
      "expect": [] }
  ]
}
